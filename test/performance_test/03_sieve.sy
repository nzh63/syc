// 埃拉托斯特尼筛：顺序写 + 跨步扫描访存
char composite[200000];

int main() {
  int rounds = 250;
  int n = 200000;
  int total = 0;
  for (int r = 0; r < rounds; r = r + 1) {
    for (int i = 0; i < n; i = i + 1) composite[i] = 0;
    for (int i = 2; i * i < n; i = i + 1) {
      if (composite[i] == 0) {
        for (int j = i * i; j < n; j = j + i) composite[j] = 1;
      }
    }
    int count = 0;
    for (int i = 2; i < n; i = i + 1) {
      if (composite[i] == 0) count = count + 1;
    }
    total = total + count;
  }
  putint(total);
  putch(10);
  return 0;
}
