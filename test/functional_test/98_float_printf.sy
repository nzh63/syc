// printf 变参浮点：格式与槽位分配（含栈传参与 r3 拆分）
int main() {
  putf("%f|%e|%g\n", 3.75, 12345.6789, 0.000125);
  putf("%d %f %d %f\n", 1, 2.5, 3, 4.5);
  putf("%f %d %f %d %f\n", 1.5, 2, 3.5, 4, 5.5);
  putf("%d %d %d %f\n", 1, 2, 3, 4.5);
  putf("%f\n", 2.5);
  putf("%e\n", 1.0);
  putf("%g\n", 250.0);
  putf("%s|%c|%d\n", "str", 'A', 65);
  return 0;
}
