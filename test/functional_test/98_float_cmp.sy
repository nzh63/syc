// 浮点比较与条件判断
int main() {
  float a = 1.5f;
  float b = 2.5f;
  if (a < b) putf("%s\n", "1"); else putf("%s\n", "0");
  if (a > b) putf("%s\n", "1"); else putf("%s\n", "0");
  if (a <= b) putf("%s\n", "1"); else putf("%s\n", "0");
  if (a >= b) putf("%s\n", "1"); else putf("%s\n", "0");
  if (a == b) putf("%s\n", "1"); else putf("%s\n", "0");
  if (a != b) putf("%s\n", "1"); else putf("%s\n", "0");
  if (a <= a) putf("%s\n", "1"); else putf("%s\n", "0");
  if (a >= a) putf("%s\n", "1"); else putf("%s\n", "0");
  double x = 1.0 / 3.0;
  double y = x * 3.0;
  if (y == 1.0) putf("%s\n", "1"); else putf("%s\n", "0");
  if (y == 1.0) putf("%s\n", "eq"); else putf("%s\n", "ne");
  if (a < b) putf("%s\n", "lt");
  if (a > b) putf("%s\n", "no");
  int i = 0;
  float s = 0.0f;
  while (s < 2.0f) {
    s = s + 0.6f;
    i = i + 1;
  }
  putf("%d\n", i);
  putf("%f\n", s);
  if (s) putf("%s\n", "nz");
  float z = 0.0f;
  if (!z) putf("%s\n", "zero");
  if (1 && 0.5) putf("%s\n", "1"); else putf("%s\n", "0");
  if (0.0 || 2) putf("%s\n", "1"); else putf("%s\n", "0");
  if (-0.0) putf("%s\n", "1"); else putf("%s\n", "0");
  return 0;
}
